---
import Layout from "../layouts/Layout.astro";
import WavyText from "../components/WavyText.astro";

const socials = [
  {
    name: "Blog",
    link: "/blog",
    color: "text-white",
  },
  {
    name: "Github",
    link: "https://github.com/NazarShuk",
    color: "text-gray-500",
  },
  {
    name: "YouTube",
    link: "https://youtube.com/@nshis",
    color: "text-red-500",
  },
  {
    name: "TikTok",
    link: "https://tiktok.com/@czar_nazar",
    color: "text-purple-300",
  }
];
---

<Layout>
  <main
    class="flex h-screen w-full flex-col items-center justify-center text-center"
  >
    <h1 class="text-8xl">
      <WavyText text="NshIS" />
    </h1>

    <p class="mt-5">
      hi my name is nazar
      <br />
      i code sometimes
      <br />

    </p>

    <div class="mt-5 flex w-full flex-row items-center justify-center gap-5">
      {
        socials.map((social) => {
          return (
            <a
              target="_blank"
              href={social.link}
              class="flex flex-col items-center justify-center gap-2"
            >
              <h2 class={`text-xl font-bold ${social.color}`}>{social.name}</h2>
            </a>
          );
        })
      }
    </div>
  </main>
</Layout>
