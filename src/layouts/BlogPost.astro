---
const { frontmatter } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title} - Blog</title>

    <meta property="og:title" content={`${frontmatter.title} - NshIS Blog`} />
    <meta property="og:url" content="https://www.nshis.com/" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${frontmatter.title} - NshIS Blog`} />
    <meta name="twitter:image" content="https://www.nshis.com/" />
  </head>
  <body>
    <main class="w-full flex justify-center">
        <div class="lg:w-1/2 w-full">
            <a href="/blog" class="mb-5">go back</a>
            <slot />
        </div>
    </main>
  </body>
</html>
